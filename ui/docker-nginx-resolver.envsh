#!/bin/sh
set -eu

: "${POLPO_API_UPSTREAM:=http://server:3890}"

if [ -z "${NGINX_RESOLVER:-}" ]; then
  NGINX_RESOLVER="$(awk '/^nameserver[ \t]+/ { print $2; exit }' /etc/resolv.conf)"
fi

if [ -z "${NGINX_RESOLVER:-}" ]; then
  echo "Could not determine nginx DNS resolver from /etc/resolv.conf" >&2
  exit 1
fi

export POLPO_API_UPSTREAM
export NGINX_RESOLVER
