{
  "name": "ui",
  "private": true,
  "version": "0.1.23",
  "license": "MIT",
  "author": {
    "name": "Lumea Labs",
    "email": "hello@polpo.ai"
  },
  "homepage": "https://github.com/lumea-labs/polpo",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron:dev": "POLPO_ELECTRON=1 VITE_POLPO_API_URL=http://localhost:3890 vite build && electron .",
    "electron:build": "POLPO_ELECTRON=1 VITE_POLPO_API_URL=http://localhost:3890 vite build && electron-builder"
  },
  "dependencies": {
    "@ai-sdk/react": "^3.0.88",
    "@iconify-json/logos": "^1.2.11",
    "@iconify/react": "^6.0.2",
    "@lobehub/icons": "^2.46.0",
    "@polpo-ai/react": "workspace:*",
    "@radix-ui/react-use-controllable-state": "^1.2.2",
    "@streamdown/cjk": "^1.0.2",
    "@streamdown/code": "^1.0.2",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@tailwindcss/vite": "^4.1.18",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.10.1",
    "ai": "^6.0.86",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "electron-updater": "^6.8.3",
    "lucide-react": "^0.564.0",
    "nanoid": "^5.1.6",
    "next-themes": "^0.4.6",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.4.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.9.0",
    "react-router-dom": "^7.13.0",
    "react-virtuoso": "^4.18.1",
    "recharts": "^2.15.4",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "streamdown": "^2.2.0",
    "tailwind-merge": "^3.4.1",
    "tailwindcss": "^4.1.18",
    "use-stick-to-bottom": "^1.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@iconify-json/vscode-icons": "^1.2.49",
    "@types/node": "^24.10.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.2.3",
    "electron": "^35",
    "electron-builder": "^26",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "shadcn": "^3.8.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^1.2.0"
  },
  "build": {
    "appId": "ai.polpo.desktop",
    "productName": "Polpo",
    "icon": "build/icon.png",
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "from": "binaries/",
        "to": ".",
        "filter": [
          "polpo-server*"
        ]
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "lumea-labs",
      "repo": "polpo"
    }
  }
}
